# Valores fictícios — copie para .env e troque TODOS os segredos.
POSTGRES_DB=vencecerto
POSTGRES_USER=vencecerto
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://vencecerto:change-me-db-password@db:5432/vencecerto

JWT_SECRET=change-me-with-64-random-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:8080
ENVIRONMENT=development
SEED_DEMO_DATA=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# IA opcional. "none" (padrão) = somente estatística local; o núcleo nunca depende disso.
AI_PROVIDER=none

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
